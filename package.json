{
  "name": "duanos",
  "version": "0.1.1",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "ios": "expo start --ios",
    "android": "expo start --android",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "check": "npm run typecheck && npm test && npm run test:ui && expo install --check",
    "export": "expo export --platform all",
    "test:ui": "jest --runInBand"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~55.0.0",
    "expo-crypto": "~55.0.19",
    "expo-notifications": "~55.0.27",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-native": "0.83.10",
    "react-native-safe-area-context": "~5.6.2",
    "react-native-web": "~0.21.0"
  },
  "devDependencies": {
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.2.0",
    "jest": "^29.7.0",
    "jest-expo": "~55.0.22",
    "react-test-renderer": "^19.2.0",
    "typescript": "~5.9.2"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
